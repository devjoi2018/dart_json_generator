{
  "outputPath": "./output",
  "defaultRecordCount": 3,
  "jsonIndent": "    ",
  "addTimestampToFiles": true,
  "dates": {
    "format": "shortDate",
    "customFormat": "yyyy-MM-dd HH:mm:ss",
    "timeZone": "UTC"
  },
  "generation": {
    "type": "realistic",
    "seed": null,
    "enableCache": true
  },
  "files": {
    "extension": "json",
    "encoding": "utf-8",
    "defaultSingleName": "object",
    "defaultListName": "list",
    "maxSize": 10485760
  },
  "templates": {
    "directory": "templates",
    "defaultTemplate": "",
    "validateData": true,
    "allowWithoutTemplate": true
  },
  "logging": {
    "level": "debug",
    "toFile": true,
    "toConsole": true
  }
}